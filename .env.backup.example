# Copy this file to .env.backup.local. The local file is ignored by Git.

# Supabase Dashboard -> Connect -> Session Pooler connection string.
# Percent-encode special characters in the database password.
SUPABASE_DB_URL=

# Absolute private directory outside this repository.
SUPABASE_BACKUP_DIR=/absolute/path/to/private/backups

# Public recipient printed by: age-keygen -o /secure/path/age-key.txt
SUPABASE_BACKUP_AGE_RECIPIENT=

# The app currently stores uploaded files in this bucket.
SUPABASE_BACKUP_BUCKETS=meetup-media

# Optional: number of simultaneous Storage downloads, from 1 through 16.
SUPABASE_BACKUP_STORAGE_CONCURRENCY=4
