# Public Supabase client values. Safe to expose in browser builds.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase key. Never expose this with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Organizer-capable runtimes require Supabase. Use local-json only for public-only local work.
APP_DATA_SOURCE=supabase

# Independent server-side gate for the public community event proposal endpoint.
# Only an explicit true accepts requests; keep false outside approved beta windows.
PUBLIC_EVENT_SUBMISSIONS_ENABLED=false

# Independent public-feed gate for events promoted from public submissions.
# Keep false during private beta; enable only after beta cleanup is verified.
PUBLIC_EVENT_SUBMISSIONS_PUBLIC_DISCOVERY_ENABLED=false

# Server-generated auth links use this public app origin in hosted environments.
PUBLIC_APP_URL=
PUBLIC_FRONTEND_ORIGIN=

# Public forms fail closed in production unless Turnstile can be verified.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
EVENT_SUBMISSION_TURNSTILE_EXPECTED_HOSTNAMES=devcongress.org,www.devcongress.org
TURNSTILE_EXPECTED_HOSTNAME=

# Server-only transactional email delivery. Never use a VITE_ prefix for the API key.
RESEND_API_KEY=
RESEND_BROADCASTS_API_KEY=
SPEAKER_EMAIL_FROM="DevCongress Monthly Speakers <speakers@updates.devcongress.org>"
SPEAKER_EMAIL_REPLY_TO=hello@devcongress.org
# Registration is a distinct attendee-facing product identity; do not reuse the speaker sender.
REGISTRATION_EMAIL_FROM="DevCongress Events <events@updates.devcongress.org>"
REGISTRATION_EMAIL_REPLY_TO=hello@devcongress.org
EVENT_EMAIL_REPLY_TO=hello@devcongress.org

# Optional signed Reply-To routing for community-submission emails. Configure
# the domain's Resend receiving MX records before enabling these values.
EVENT_SUBMISSION_REPLY_DOMAIN=inbox.devcongress.org
EVENT_SUBMISSION_REPLY_TOKEN_SECRET=
# Resend inbound webhook signing secret (whsec_...).
RESEND_INBOUND_WEBHOOK_SECRET=
# Optional Slack incoming webhook for a private submission-replies channel.
SLACK_EVENT_SUBMISSION_WEBHOOK_URL=

# Server-only Google Places (New) key for authenticated Ghana venue autocomplete.
GOOGLE_MAPS_PLACES_API_KEY=

# Optional route hardening for organizer pages.
VITE_ADMIN_BASE_PATH=/organizer-console
VITE_SHOW_ORGANIZER_LINK=true
