{
  "name": "events-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "APP_DATA_SOURCE=supabase vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "deploy:worker": "wrangler deploy",
    "start": "bun run server/index.ts",
    "atlas": "SCENARIO_ATLAS_PORT=4178 bun run tools/scenario-atlas/server.ts",
    "atlas:test": "vitest run tools/scenario-atlas && bun test tools/scenario-atlas/engine/database.bun.test.ts",
    "typecheck": "vue-tsc --noEmit",
    "seed": "tsx data/seed.ts",
    "cleanup:test-events": "bun run scripts/cleanup-test-event-data.ts",
    "cleanup:private-beta-events": "bun run scripts/cleanup-test-event-data.ts --scope private-beta",
    "backup:supabase": "node --import tsx scripts/backup-supabase.ts",
    "backup:supabase:check": "node --import tsx scripts/backup-supabase.ts --preflight",
    "verify:public-api": "tsx scripts/verify-public-meetups-api.ts",
    "verify:deployed-security": "node --import tsx scripts/security/verify-deployed-security.ts",
    "dast:staging": "node --import tsx scripts/security/run-staging-dast.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "vitest run",
    "test:journeys": "node scripts/organizer-journeys.mjs",
    "audit:dependencies": "pnpm audit --audit-level moderate"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/vue-query": "^5.101.0",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "@usenavii/core": "^0.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "disposable-email-domains-js": "1.25.0",
    "hono": "^4.13.7",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.4.0",
    "uuid": "^11.0.5",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.3.4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.4.24",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8",
    "wrangler": "^4.130.0"
  },
  "pnpm": {
    "overrides": {
      "@hono/vite-dev-server>@hono/node-server": "2.0.12",
      "postcss-selector-parser": "6.1.3",
      "@hono/vite-dev-server>minimatch": "10.2.6",
      "brace-expansion": "5.0.9",
      "browserslist": "4.28.7",
      "nanoid": "3.3.18",
      "sharp": "0.35.4",
      "undici": "7.29.0",
      "tsx>esbuild": "0.28.1"
    }
  }
}
