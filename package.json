{
  "name": "events-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "deploy:worker": "wrangler deploy",
    "start": "bun run server/index.ts",
    "typecheck": "vue-tsc --noEmit",
    "seed": "tsx data/seed.ts",
    "verify:public-api": "tsx scripts/verify-public-meetups-api.ts",
    "test": "vitest run",
    "audit:dependencies": "pnpm audit --audit-level moderate"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/vue-query": "^5.101.0",
    "@usenavii/core": "^0.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.27",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.4.0",
    "uuid": "^11.0.5",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@types/bun": "^1.3.4",
    "@types/node": "^26",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "playwright": "^1.62.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8",
    "wrangler": "^4.115.0"
  },
  "pnpm": {
    "overrides": {
      "@hono/vite-dev-server>@hono/node-server": "2.0.12",
      "@hono/vite-dev-server>minimatch": "10.2.6",
      "tsx>esbuild": "0.28.1"
    }
  }
}
